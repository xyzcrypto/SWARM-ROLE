# ============================================================
# XYZ Crypto — Environment variables
# Copy this file to ".env" and fill in the values.
# ============================================================

# --- Database (Supabase Postgres) ---
# DATABASE_URL = Supabase POOLED connection (Transaction mode, port 6543).
#   Settings → Database → Connection string → "Transaction" / "Connection pooling"
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL = Supabase DIRECT connection (port 5432) — used for migrations.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Seed admin password (set before `npm run seed`; change after first login).
SEED_ADMIN_PASSWORD=""

# --- NextAuth ---
# Generate a secret with:  openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
# Local: http://localhost:3000  |  Production: your deployed URL
NEXTAUTH_URL="http://localhost:3000"

# --- Google login (Gmail sign-in) — optional but recommended ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:  <NEXTAUTH_URL>/api/auth/callback/google
# If left empty, the site still works with email/password sign-up.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- GitHub login — optional ---
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL:  <NEXTAUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- X (Twitter) login — optional ---
# Create an app at https://developer.x.com (OAuth 2.0, type: Web App)
# Callback URI:  <NEXTAUTH_URL>/api/auth/callback/twitter
# NOTE: X's OAuth 2.0 does not share the user's email — such accounts get a
# placeholder address, so email features (OTP/notifications) won't reach them.
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# --- Admin bootstrap ---
# Any user who signs up / logs in with this email is auto-promoted to ADMIN,
# unlocking the content dashboard (/dashboard) where you upload research,
# articles & posts and view signup analytics.
ADMIN_EMAIL="you@example.com"
# Multiple admins (comma-separated). Preferred over ADMIN_EMAIL when set.
ADMIN_EMAILS=""

# --- Rate limiting (optional, recommended for production) ---
# Upstash Redis (serverless-safe). If unset, rate limiting is a no-op.
# Create a free DB at https://console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Image upload (Supabase Storage, optional) ---
# When set, the post editor can upload cover images. Without these the URL
# field still works (upload is simply disabled). Create a PUBLIC bucket named
# "post-covers" in Supabase → Storage first.
SUPABASE_URL="https://PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""   # Supabase → Settings → API → service_role key (keep secret!)
SUPABASE_STORAGE_BUCKET="post-covers"

# --- XYZ AI assistant (Groq, optional, FREE) ---
# Powers the floating "XYZ AI" research assistant + article TL;DRs + chat
# auto-moderation. Groq's free tier is fast with generous limits. Get a FREE key
# at https://console.groq.com/keys (no credit card). Without it every AI surface
# no-ops: the launcher shows "not configured" (no crash, no cost).
GROQ_API_KEY=""
# Optional second AI provider - promotes Gemini to primary (Groq auto-fallback)
# when set. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Overrides the default provider chain order, e.g. "gemini,groq". Optional.
AI_PROVIDER_ORDER=""
# Optional per-plan daily AI request caps (overrides the built-in defaults).
AI_DAILY_LIMIT_FREE=""
AI_DAILY_LIMIT_PREMIUM=""
AI_DAILY_LIMIT_ADMIN=""

# --- Community chat realtime (optional) ---
# Same Supabase project. The ANON key is designed to be public (client-side);
# it only grants what channel/RLS policy allows. Without these two, the chat
# page falls back to 10s polling — still fully functional.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""   # Supabase → Settings → API → anon public key

# --- Community chat GIF search (Giphy, optional) ---
# Get a free key at https://developers.giphy.com. Without it the GIF picker in
# community chat is simply hidden - no crash.
GIPHY_API_KEY=""

# --- Web Push notifications (optional) ---
# Generate a VAPID key pair with:  npx web-push generate-vapid-keys
# Powers the /news "Enable alerts" push toggle + the breaking-news dispatch cron.
# Without all three, push is off (no crash, no cost).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
# Shared secret checked by the push-dispatch/watchdog cron endpoints
# (.github/workflows/push-dispatch.yml, watchdog.yml). Generate with:
# openssl rand -hex 32
CRON_SECRET=""

# --- Markets hub enrichment (CoinMarketCap, optional) ---
# Adds DeFi/stablecoin market-cap metrics to /markets. Without it the hub still
# works fully from the free keyless sources (CoinGecko + DefiLlama + Fear&Greed).
CMC_API_KEY=""

# --- Community voice rooms (LiveKit, optional) ---
# Create a free project at https://cloud.livekit.io. All three needed together
# to enable the "Join voice" bar in community chat; without them it's hidden.
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
NEXT_PUBLIC_LIVEKIT_URL=""

# --- XYZ Sentinel security alerts (Telegram, optional) ---
# Lets the security watchdog (.github/workflows/watchdog.yml) message the owner
# directly on new warn/critical findings, alongside email. Both required together.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Email / OTP (Resend) ---
# Used for signup verification, 2FA login codes and password-reset codes.
# Get a free key at https://resend.com → API Keys. If unset, OTP codes are
# printed to the server logs (so the flow still works for testing).
RESEND_API_KEY=""
# Verified sender. Use "onboarding@resend.dev" to test, or your own verified
# domain in production, e.g. "XYZ Crypto <noreply@xyzcrypto.io>".
EMAIL_FROM="XYZ Crypto <onboarding@resend.dev>"

# --- Error monitoring (Sentry, optional but recommended) ---
# Create a free project at https://sentry.io (platform: Next.js) and paste the
# DSN here. Monitoring is a complete no-op until this is set.
NEXT_PUBLIC_SENTRY_DSN=""
# Server-side error reporting - separate from the client-side DSN above (both
# read the same Sentry project's DSN value; set both to the same value).
SENTRY_DSN=""
# Optional: only needed to upload source maps during build (readable stack traces).
SENTRY_AUTH_TOKEN=""

# --- SEO & Analytics (all optional) ---
# Public canonical site URL (used for metadata, sitemap.xml, robots.txt, JSON-LD).
# e.g. https://xyzcrypto.io  (falls back to NEXTAUTH_URL if unset)
NEXT_PUBLIC_SITE_URL=""
# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX (empty = analytics off)
NEXT_PUBLIC_GA_ID=""
# Google Search Console verification token (the content of the meta tag)
NEXT_PUBLIC_GSC_VERIFICATION=""
