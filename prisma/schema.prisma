// XYZ Crypto database schema — Supabase Postgres.
//
// DATABASE_URL  = Supabase POOLED connection (Transaction mode, port 6543).
//                 MUST include `?pgbouncer=true` — this disables prepared
//                 statements, which the pgbouncer pooler does not support.
//                 Without it, serverless requests fail with:
//                 "42P05 prepared statement \"sN\" already exists".
//                 Recommended: `?pgbouncer=true&connection_limit=1`.
// DIRECT_URL    = Supabase DIRECT connection (port 5432) — used for migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("USER") // "USER" | "ADMIN"
  membership    String    @default("Free") // "Free" | "Premium"
  provider      String    @default("credentials") // "credentials" | "google"
  createdAt     DateTime  @default(now())
  lastLoginAt   DateTime?
  // "last seen" for DMs. Written by the presence endpoints the site ALREADY
  // calls (the site-wide heartbeat and the pagehide beacon), so this costs no
  // new requests. It is deliberately not on ChatPresence: that row is deleted
  // on leave, which is exactly the moment a last-seen time becomes interesting.
  lastSeenAt    DateTime?
  // Who may open a DM with this member: "everyone" | "following" | "nobody".
  // "following" means people THIS user follows - the inbox they opted into,
  // not the crowd who opted into them.
  dmPrivacy     String    @default("everyone")

  // Brute-force defence (works without Upstash): lock the account for a short
  // window after repeated failed password attempts; reset on success.
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  // When the password was last changed. Any JWT minted before this instant is
  // revoked on its next refresh (see the `pwdAt` check in core/auth/auth.ts).
  // Nullable on purpose: existing users have no value, which reads as "never
  // changed", so deploying this does NOT sign the whole userbase out.
  passwordChangedAt DateTime?

  // Granular staff capabilities (catalog in src/lib/permissions.ts). Super Admins
  // (ADMIN_EMAILS) implicitly hold all permissions regardless of this column.
  permissions String[] @default([])

  // News hub: categories the member follows for their personalized "For You" feed.
  newsInterests String[] @default([])

  // Per-user daily AI request override (null = use the plan default). Set by the
  // admin AI-usage editor; capped/enforced by src/lib/ai/limits.ts.
  aiDailyLimit Int?

  // --- Public profile fields (see /u/[username] + /settings) ---
  username    String? @unique // handle for the public profile URL, 3–20 [a-z0-9_]
  bio         String? // short about, <= 280 chars
  location    String? // free text, <= 80 chars
  website     String? // full URL
  twitter     String? // handle only (no @ / URL)
  github      String? // handle only
  telegram    String? // handle only
  discord     String? // invite code / handle (migration 20)
  youtube     String? // channel handle, no @ (migration 20)
  linkedin    String? // profile/company slug (migration 20)
  instagram   String? // handle only (migration 20)
  bannerImage String? // optional profile cover image URL

  posts             Post[]
  accounts          Account[]
  sessions          Session[]
  comments          Comment[]
  likes             PostLike[]
  chatMessages      ChatMessage[]
  chatReactions     ChatReaction[]
  chatReports       ChatReport[]
  chatBookmarks     ChatBookmark[]
  chatPollVotes     ChatPollVote[]
  notifications     Notification[]
  adminAudits       AdminAudit[]           @relation("AdminAuditActor")
  pushSubscriptions PushSubscription[]
  aiUsage           AiUsage[]
  savedStories      SavedStory[]
  newsLikes         NewsLike[]
  newsComments      NewsComment[]
  conversationsA    Conversation[]         @relation("ConvUserA")
  conversationsB    Conversation[]         @relation("ConvUserB")
  directMessages    DirectMessage[]        @relation("DMSender")
  followers         Follow[]               @relation("Following") // rows where this user is followed
  following         Follow[]               @relation("Follower") // rows where this user follows someone
  blocksMade        Block[]                @relation("Blocker") // people this user blocked
  blocksAgainst     Block[]                @relation("Blocked") // people who blocked this user
  reportsMade       Report[]               @relation("Reporter")
  reportsAgainst    Report[]               @relation("ReportSubject")
  trades            Trade[]
  riskProfile       RiskProfile?
  challenges        Challenge[]
  challengeEntries  ChallengeParticipant[]
  challengeDayNotes ChallengeDayNote[]
  journalActivities JournalActivity[]
  chatPresence      ChatPresence?

  // Basic engagement XP (foundation for a future gamified system). Denormalized
  // counter kept in sync with XpEvent rows inside a transaction.
  xp       Int       @default(0)
  xpEvents XpEvent[]

  // XYZ Crypto Academy (/academy). A separate ledger from the engagement XP
  // above: Academy XP is earned by answering correctly, so it ranks learners,
  // and the 1-XP-a-day engagement actions must not move those rankings.
  academyProfile      AcademyProfile?
  academyXp           AcademyXp[]
  academyAttempts     AcademyAttempt[]
  academyProgress     AcademyProgress[]
  academyAchievements AcademyAchievement[]
  academyLive         AcademyLiveParticipant[]
  academyCertificates AcademyCertificate[]

  @@index([createdAt]) // dashboard "new in last 7 days" aggregate
  @@index([username]) // public profile lookup
  @@index([membership, createdAt]) // dashboard premium-member list (Phase 1)
}

// One row per user per action per day - the unique constraint makes awarding
// idempotent (a second call for the same action/day is a no-op, not an error).
// `day` is a UTC "YYYY-MM-DD" string so it's portable + trivially indexable.
model XpEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  action    String // "checkin" | "research_view" | "news_read" | "tool_use" | "profile_update"
  day       String // UTC YYYY-MM-DD
  xp        Int      @default(1)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([userId, action, day])
  @@index([userId, createdAt])
}

// A persisted snapshot behind a short share link - lets /tools/share/<kind>/<id>
// stay short (a cuid) instead of a long query string, and gives the OG-image
// route a stable source of truth to re-render from. No user relation (anonymous
// tool results are shareable without login, same as the calculator itself);
// `data` is a small, kind-specific JSON blob - never raw/private data.
model SharedCard {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  kind      String // "points-value" (room for more card kinds later)
  data      Json

  @@index([kind, createdAt])
}

// In-app notifications (bell dropdown). Created server-side when a new post is
// published or someone comments on your post; delivery is in-app (polled by the
// navbar). Best-effort: creation never blocks the triggering action.
model Notification {
  id        String   @id @default(cuid())
  type      String // "new_post" | "new_comment" | "new_message" | "system"
  title     String
  body      String? // optional preview line
  href      String? // where clicking the notification navigates
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId, read, createdAt]) // unread badge + recent list per user
  @@index([userId, createdAt]) // recent list ORDER BY createdAt (Phase 1)
}

// Community chat — single public room, plain-text messages. `status` enables
// moderation (visible | hidden) without hard deletes; delivery is realtime
// (Supabase broadcast) with the DB as history/source of truth.
model ChatMessage {
  id        String    @id @default(cuid())
  body      String // plain text, <= 500 chars (zod-enforced)
  kind      String    @default("text") // "text" | "poll"
  status    String    @default("visible") // "visible" | "hidden"
  // WHO hid it: "ai" for the auto-moderation filter, otherwise the moderator's
  // user id. Null while visible.
  //
  // `status` alone could not tell the two apart, so a false positive from the
  // toxicity classifier looked exactly like a deliberate staff decision in the
  // moderation queue - and "Restore all hidden" was the only recovery, which
  // also undid every human hide.
  hiddenBy  String?
  createdAt DateTime  @default(now())
  editedAt  DateTime? // set when the author edits (15-min window)
  pinnedAt  DateTime? // set when staff pins (Telegram-style; latest pinned shows in the banner)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Reply / quote (self-relation). Detaches (null) if the parent is removed.
  replyToId String?
  replyTo   ChatMessage?  @relation("ChatReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ChatMessage[] @relation("ChatReply")

  reactions ChatReaction[]
  poll      ChatPoll?
  reports   ChatReport[]
  bookmarks ChatBookmark[]

  @@index([status, createdAt]) // history queries: visible, newest-first
}

// Telegram-style poll attached to a chat message (kind = "poll"; the message
// body carries the question for graceful fallback rendering).
model ChatPoll {
  id        String   @id @default(cuid())
  question  String // <= 200 chars (zod-enforced)
  createdAt DateTime @default(now())

  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String      @unique

  options ChatPollOption[]
  votes   ChatPollVote[]
}

model ChatPollOption {
  id    String @id @default(cuid())
  text  String // <= 80 chars (zod-enforced)
  order Int    @default(0)

  poll   ChatPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId String

  votes ChatPollVote[]

  @@index([pollId, order])
}

// One vote per user per poll; changing your vote updates the row, voting the
// same option again retracts it (Telegram behaviour).
model ChatPollVote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  poll     ChatPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId   String
  option   ChatPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionId String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String

  @@unique([pollId, userId])
  @@index([optionId])
}

// Emoji reactions on chat messages — one row per (message, user, emoji).
model ChatReaction {
  id        String   @id @default(cuid())
  emoji     String // from a fixed allowlist (see src/lib/chat.ts)
  createdAt DateTime @default(now())

  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// A user-submitted report on a chat message.
//
// Additive and deliberately small: moderation already exists
// (`ChatMessage.status` + `hiddenBy`), so this stores WHO flagged WHAT and WHY,
// and nothing else. It does not duplicate moderation state and it does not
// touch any existing table.
model ChatReport {
  id        String   @id @default(cuid())
  reason    String // harassment | spam | scam | illegal | threat | other
  details   String? // optional free text, length-capped server-side
  status    String   @default("open") // open | reviewed | dismissed - STAFF ONLY
  createdAt DateTime @default(now())

  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  // ⚠️ One report per person per message, enforced by the DB rather than by a
  // client-side check. A duplicate attempt returns the same success the first
  // did, so it cannot be used to probe whether a report already exists.
  @@unique([messageId, userId])
  @@index([status, createdAt])
}

model Post {
  id        String    @id @default(cuid())
  title     String
  slug      String    @unique
  excerpt   String
  content   String // markdown / long text
  cover     String? // image URL
  category  String    @default("Research") // Research | Article | Post
  tags      String    @default("") // comma separated
  published Boolean   @default(true)
  premium   Boolean   @default(false) // Premium Content — body gated to Premium users
  summary   String? // AI-generated TL;DR (XYZ AI) — shown atop the article
  views     Int       @default(0) // total opens (incremented on the article page)
  // Soft delete. Non-null means "in the trash": hidden from every read path,
  // restorable, and purged only by an explicit second action.
  //
  // ⚠️ This exists because DELETE /api/research/[id] called prisma.post.delete
  // and a published article was gone from Postgres with no way back short of a
  // database backup. One misclick, one article.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId String?
  comments Comment[]
  likes    PostLike[]

  // Supports the research list query: where published+category order by createdAt
  @@index([published, category, createdAt])
}

// Post likes — one per user per post; toggled via /api/posts/[id]/like.
model PostLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([postId, userId])
}

// Saved news stories — one per user per external story URL. Stores enough of the
// story to render the "Saved" tab without re-fetching the live feed (which ages
// out), so saves persist across devices + time. Toggled via /api/news/saved.
model SavedStory {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  url         String
  title       String
  summary     String?
  source      String?
  image       String?
  category    String?
  publishedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([userId, url])
  @@index([userId, createdAt])
}

// A like on an external news story, keyed by its URL. One per user per story.
model NewsLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  url       String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([userId, url])
  @@index([url])
}

// A comment on an external news story, keyed by its URL. `status` allows
// hiding (moderation) without deleting.
model NewsComment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  url       String
  body      String
  status    String   @default("visible") // "visible" | "hidden"
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@index([url, createdAt])
}

// Direct messages (Telegram-style 1-on-1). A Conversation is the canonical pair
// of two users, stored with userAId < userBId so the pair is unique regardless
// of who opens it. Denormalized last-message fields let the inbox render in a
// single query (no join to messages) and drive the unread badge.
model Conversation {
  id            String          @id @default(cuid())
  createdAt     DateTime        @default(now())
  lastMessageAt DateTime        @default(now())
  lastBody      String? // preview snippet of the most recent message
  lastSenderId  String? // who sent the last message (for the unread calc)
  userAId       String
  userBId       String
  readAAt       DateTime? // when user A last opened the thread
  readBAt       DateTime? // when user B last opened the thread
  pinnedByA     Boolean         @default(false) // user A pinned this conversation in their inbox
  pinnedByB     Boolean         @default(false) // user B pinned this conversation in their inbox
  hiddenByA     Boolean         @default(false) // user A removed this conversation from their inbox
  hiddenByB     Boolean         @default(false) // user B removed this conversation from their inbox
  userA         User            @relation("ConvUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB         User            @relation("ConvUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages      DirectMessage[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
}

model DirectMessage {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  body           String
  // Mirrors ChatMessage: deletes are soft, so the thread keeps its shape and a
  // report stays investigable after the sender removes the evidence.
  status         String       @default("visible") // "visible" | "deleted"
  // Delete for me, as opposed to `status: "deleted"` which is delete for
  // everyone. Named to match Conversation.hiddenByA/B, which already means
  // "this side removed it from their view" for a whole thread.
  //
  // Two columns rather than one relation because a DM has exactly two
  // participants and "A"/"B" are already fixed by Conversation.userAId/userBId
  // - the same shape the pin and hide flags above use.
  hiddenByA      Boolean      @default(false) // user A removed this message from their own view
  hiddenByB      Boolean      @default(false) // user B removed this message from their own view
  editedAt       DateTime?
  pinnedAt       DateTime?
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("DMSender", fields: [senderId], references: [id], onDelete: Cascade)

  // Reply / quote (self-relation), mirroring ChatMessage. Detaches (null) if
  // the parent is removed, so a thread never points at a ghost row.
  //
  // ⚠️ Unlike the community room, DMs are private and there are many of them,
  // so the API must also check the parent belongs to the SAME conversation.
  // The FK alone would happily quote a message from someone else's thread.
  replyToId String?
  replyTo   DirectMessage?  @relation("DMReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   DirectMessage[] @relation("DMReply")

  // "Forwarded" is a flag, not a link. A reference to the original would point
  // into a conversation the recipient has no right to read, and resolving it
  // for a preview would leak that thread. WhatsApp shows the same bare label
  // for the same reason.
  forwarded Boolean @default(false)

  // One reaction per participant, the WhatsApp / iMessage model: each side can
  // put at most one emoji on a message, and tapping it again takes it off. Two
  // nullable columns rather than a table, for the same reason as hiddenByA/B -
  // a DM has exactly two participants and A/B are already fixed by the
  // conversation. Validated against a fixed set server-side (dm-reactions.ts).
  reactionA String? // user A's reaction on this message
  reactionB String? // user B's reaction on this message

  @@index([conversationId, createdAt])
  // The pinned banner is "the newest pinned message in this conversation".
  @@index([conversationId, pinnedAt])
  // Loading a thread filters on the requester's own hidden flag. Two indexes
  // rather than one because the filtered column depends on which participant
  // is asking, and Postgres can still use the leading `conversationId` of
  // either for the unfiltered shape.
  @@index([conversationId, hiddenByA, createdAt])
  @@index([conversationId, hiddenByB, createdAt])
}

// Post comments — auto-published, logged-in users only; `status` enables
// moderation (visible | hidden) without deleting.
model Comment {
  id        String   @id @default(cuid())
  body      String
  status    String   @default("visible") // "visible" | "hidden"
  createdAt DateTime @default(now())

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([postId, createdAt])
}

// Lightweight self-hosted page-view analytics. One row per tracked view
// (deduped per session client-side); admin aggregates totals + today.
model PageView {
  id        String   @id @default(cuid())
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt]) // analytics filters/sorts (Phase 1)
}

// Email waitlist / newsletter capture (low-friction, no account needed)
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("website") // where the signup came from
  createdAt DateTime @default(now())
}

// --- NextAuth adapter models ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// One-time codes for email OTP (signup verification, 2FA login, password reset).
// Only the bcrypt hash of the code is stored; codes are single-use and expire.
model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  purpose   String // "signup" | "login" | "reset"
  codeHash  String
  payload   String? // JSON (e.g. pending signup: name + passwordHash)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

// "What's New" feed — admin-managed changelog surfaced on the homepage. Entries
// are created automatically when research is published (postId set) and manually
// by staff with the `whatsnew:manage` permission. Filterable/searchable by tag.
model WhatsNewEntry {
  id        String   @id @default(cuid())
  title     String
  body      String
  tag       String   @default("New") // New | Improved | Fixed | Announcement | Security | Roadmap
  date      DateTime @default(now())
  postId    String? // linked research post for auto-generated entries
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([published, date]) // public feed ordering
  @@index([tag, date]) // tab filtering
}

// Perp DEX / airdrop updates, posted by staff and shown live on /points.
//
// Separate from WhatsNewEntry on purpose: that feed is about THIS SITE
// shipping things, this one is about the outside world - a programme opening,
// a snapshot landing, a TGE date. Mixing them would make both unreadable, and
// the audiences are different people.
model PointsUpdate {
  id        String  @id @default(cuid())
  title     String
  body      String
  // live | soon | snapshot | tge | ended | alert | update - see points-updates.ts
  kind      String  @default("update")
  // Optional DEX_REGISTRY id, so an update can be attributed to a programme
  // without a foreign key to a table that does not exist (the registry is a
  // TypeScript array, not a DB table).
  program   String?
  url       String?
  // Optional cover, uploaded through /api/upload to Supabase Storage. A URL,
  // never inline base64: a `data:` image stored in the DB is serialised into
  // every response that reads this table, which blew Fast Origin Transfer on
  // this project once already (cost-check, trap 4).
  image     String?
  pinned    Boolean @default(false)
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The public feed's exact ordering: published first, pinned to the top,
  // newest after that.
  @@index([published, pinned, createdAt])
}

// Web Push subscriptions (news alerts). One row per browser endpoint; tied to a
// user so we can target + clean up. Dead endpoints are pruned on send (410/404).
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  // Notification preference (per-device). "high" = all high-impact (default,
  // preserves prior behavior), "foryou" = only the user's newsInterests,
  // "categories" = only notifyCategories, "off" = none.
  notifyMode       String   @default("high")
  notifyCategories String[] @default([])

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  @@index([userId])
}

// Dedupe log so the same news story is never pushed twice.
model PushedStory {
  url       String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Audit trail for sensitive admin actions (role/permission grants). Append-only;
// keeps a who/what/when record so access changes are reviewable.
model AdminAudit {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  action    String // e.g. "access.update"
  targetId  String? // affected user id
  detail    String? // short JSON summary of the change
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Per-call AI usage log — one row per gateway call. Metadata only (NEVER the
// prompt/response text): powers per-user daily limits, the admin AI dashboard
// and cost visibility. userId is nullable + SET NULL so analytics survive
// account deletion. Cost is integer micro-dollars (1e-6 USD) to avoid float drift.
model AiUsage {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider         String // "groq" | "gemini" | "none"
  model            String
  task             String // "assistant" | "summary" | "moderation" | "why" | "digest"
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  latencyMs        Int      @default(0)
  status           String // "ok" | "fallback" | "error"
  errorKind        String? // "rate_limit" | "auth" | "timeout" | "safety" | "server" | "unknown"
  estCostUsdMicros Int      @default(0)
  cached           Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt]) // per-user daily count (limits) + top users
  @@index([provider, createdAt]) // provider split / health
}

// XYZ Sentinel — one row per scheduled security/health check. Used for history
// (a future dashboard) and to dedupe alerts (only notify when flags change vs
// the previous run). See src/app/api/watchdog/route.ts. (migration 21)
model WatchdogRun {
  id       String   @id @default(cuid())
  ranAt    DateTime @default(now())
  severity String // "ok" | "info" | "warn" | "critical"
  flags    String[] // human-readable hard-rule flags that tripped
  summary  String? // AI-written risk summary (advisory)
  metrics  Json? // the raw Signals snapshot
  alerted  Boolean  @default(false) // did we notify the owner this run?

  @@index([ranAt])
}

// Twitter-style follow graph. One row per (follower -> following) edge.
// One-way block. Enforced in BOTH directions when messaging: if either side has
// blocked the other, neither can send. A block that only silenced one direction
// would leave the blocker still receiving, which is the thing they asked to stop.
model Block {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  blocker   User   @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId String
  blocked   User   @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId String

  @@unique([blockerId, blockedId])
  // "has anyone blocked me?" is asked on every send, from the blocked side.
  @@index([blockedId])
}

// A report of a member, optionally pointing at the DM that prompted it.
//
// `messageId` is a plain string, not a relation: the message is soft-deleted
// rather than removed, but a report has to survive even if that ever changes,
// and a report about someone's behaviour is not owned by one message.
model Report {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  reason    String // "spam" | "harassment" | "scam" | "other"
  note      String?
  status    String   @default("open") // "open" | "reviewed"
  messageId String?

  reporter   User   @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId String
  subject    User   @relation("ReportSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId  String

  // The moderation queue reads "open, newest first".
  @@index([status, createdAt])
  @@index([subjectId])
}

model Follow {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  follower    User   @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  String
  following   User   @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String

  @@unique([followerId, followingId]) // can't follow the same person twice
  @@index([followingId]) // follower list + count for a profile
  @@index([followerId]) // following list + count for a profile
}

// Trading Journal (Trading OS Phase 1). One row per logged position; the
// actual entries/exits live in TradeFill (supports multiple entries and
// partial exits) - P&L, average entry price, and open/closed size are all
// DERIVED from a trade's fills (src/lib/journal.ts), never stored redundantly.
model Trade {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  symbol String // free text, e.g. "BTC", "ETH" - uppercased client-side
  side   String // "long" | "short"
  type   String @default("perp") // "spot" | "futures" | "perp" | "custom"
  status String @default("open") // "open" | "closed" | "partial" | "canceled" | "invalid"

  platformId String? // optional link to src/lib/dex-registry.ts DexPlatform.id
  leverage   Float?  @default(1)

  stopLoss   Float?
  takeProfit Float?

  setup           String? // strategy/setup tag
  marketCondition String?
  session         String? // e.g. "Asia" | "London" | "New York"
  timeframe       String?
  assetCategory   String?
  tags            String[] @default([])
  emotions        String[] @default([])
  mistakes        String[] @default([])
  lessons         String?
  notes           String?
  screenshots     String[] @default([])
  customFields    Json?

  visibility String @default("private") // "private" | "public" | "anonymous"

  fills     TradeFill[]
  revisions TradeRevision[]

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Optional link to a Trading OS challenge - progress is derived from linked
  // trades (src/lib/challenge.ts), not duplicated. SetNull so deleting a
  // challenge never deletes the trade itself.
  challenge   Challenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  challengeId String?

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([challengeId])
}

// One entry or exit execution on a Trade. Multiple entry fills = averaging in;
// multiple exit fills = scaling out / partial exits.
model TradeFill {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  kind       String // "entry" | "exit"
  price      Float
  size       Float // base-asset units
  fee        Float    @default(0)
  executedAt DateTime @default(now())

  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  tradeId String

  @@index([tradeId, executedAt])
}

// Append-only edit history. One row per PATCH, capturing what changed - a
// lightweight "trade edit history" without a full versioning system.
model TradeRevision {
  id        String   @id @default(cuid())
  changedAt DateTime @default(now())
  diff      Json // { field: { from, to } } for each changed field
  editedBy  String // userId of the editor (always the owner today)

  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  tradeId String

  @@index([tradeId, changedAt])
}

// Trading OS Phase 3 - one optional per-user risk configuration. Breach
// detection/rule-adherence scoring (src/lib/risk.ts) is all computed
// client-side from this + the trade list; this row only persists the limits
// the member has chosen to set for themselves.
model RiskProfile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountEquity          Float?
  maxRiskPerTradePct     Float?
  maxDailyLossPct        Float?
  maxWeeklyDrawdownPct   Float?
  maxOpenRiskPct         Float?
  maxLeverage            Float?
  maxTradesPerDay        Int?
  revengeCooldownMinutes Int?   @default(30)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique
}

// Trading OS Phase 4 - a custom-duration trading challenge. Duration is fully
// flexible (30/90/120-day presets are just UI shortcuts, not hardcoded modes).
// Progress is DERIVED from the trades linked to it (Trade.challengeId) plus
// startingCapital - see src/lib/challenge.ts. Not just solo: a "community"
// challenge is one creator + many ChallengeParticipant rows, ranked on a
// leaderboard by each participant's own linked trades.
model Challenge {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  description String?

  startDate       DateTime
  endDate         DateTime
  startingCapital Float
  targetCapital   Float?

  maxRiskPerTradePct   Float?
  maxDailyLossPct      Float?
  maxWeeklyDrawdownPct Float?
  customRules          String[] @default([])

  visibility String @default("private") // "private" | "public" | "community"
  status     String @default("active") // "active" | "completed" | "failed" | "abandoned"

  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String

  participants ChallengeParticipant[]
  milestones   ChallengeMilestone[]
  trades       Trade[]
  dayNotes     ChallengeDayNote[]

  @@index([creatorId, createdAt])
  @@index([visibility, status])
}

// One row per participant in a challenge (the creator is a participant too,
// role="owner" - so leaderboard queries are just "all participants").
model ChallengeParticipant {
  id       String   @id @default(cuid())
  joinedAt DateTime @default(now())
  role     String   @default("participant") // "owner" | "participant"

  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  challengeId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  @@unique([challengeId, userId])
  @@index([userId])
}

// A review checkpoint within a challenge - a lightweight, manually-toggled
// milestone (not auto-computed) so it can represent anything ("halfway
// review", "hit first profit target", a habit check-in).
model ChallengeMilestone {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  label      String
  targetDate DateTime?
  achieved   Boolean   @default(false)
  achievedAt DateTime?

  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  challengeId String

  @@index([challengeId])
}

// A participant's own per-day reflection within a challenge - optional note +
// one-tap mood. Day-by-day P&L is NEVER stored here (already free via
// periodBreakdown(trades, "day") in journal-analytics.ts) - this only holds
// what isn't derivable from the linked trades. Any participant can log their
// own day (not creator-only, unlike milestones), one row per user per day.
model ChallengeDayNote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  day  String // UTC "YYYY-MM-DD"
  note String? // free-text reflection, <=1000 chars (zod-enforced)
  mood String? // "disciplined" | "neutral" | "off-plan"

  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  challengeId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  @@unique([challengeId, userId, day])
  @@index([challengeId, userId])
}

// A public, aggregate-only log of what a member does in their Journal -
// powers the "Journal Activity" section on their public profile. Deliberately
// denormalized (title is pre-rendered at write time by journal-activity.ts,
// never re-joined at read time) so the public feed can never expose more than
// what was decided safe when the row was written. Only ever written when the
// source trade/challenge's own `visibility` is not "private" - see the write
// sites in the trade/challenge API routes.
model JournalActivity {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  type      String // "trade_opened" | "trade_closed" | "challenge_created" | "challenge_joined" | "challenge_milestone" | "challenge_completed"
  title     String // pre-rendered, safe-to-display text
  win       Boolean? // trade_closed only - sign, NEVER a dollar amount

  // What produced this row, so publishing can be UNDONE. Without these, an
  // activity row could never be traced back to its source: the title is
  // pre-rendered text like "Closed BTC long with a win", which collides across
  // every other BTC long, so matching on it would delete the wrong rows.
  // Consequence: setting a trade or challenge back to private (or deleting it)
  // left a publicly readable row naming the symbol and outcome forever.
  //
  // Deliberately NOT a relation/FK: activity must survive as an orphan if the
  // source row is hard-deleted by some path we haven't hooked, rather than
  // cascading unpredictably. The pair is looked up, never joined.
  //
  // Nullable because rows created before 2026-07-31 have no source recorded and
  // can never be traced. See docs/HANDOFF.md §8 for the one-time cleanup.
  sourceType String? // "trade" | "challenge"
  sourceId   String? // Trade.id or Challenge.id

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId, createdAt])
  @@index([sourceType, sourceId])
}

// Who is currently in a room, recorded server-side.
//
// The chat's online count used to come *only* from Supabase Realtime presence.
// That works right up until the realtime channel does not connect - and then
// the count silently reads 0 while the room is full of people, which is exactly
// the symptom the owner reported. Presence over a WebSocket is the nice path,
// not a dependable one.
//
// This is the dependable path: each open room heartbeats, and the count is a
// plain query. One row per user per room, upserted - so it cannot grow with
// traffic, only with distinct members, and stale rows are swept on read.
model ChatPresence {
  // Deliberately the user id (not a cuid): the upsert key IS the identity, so
  // a member with three tabs open is one row and counts once.
  userId String   @id
  room   String   @default("community")
  seenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The read is "distinct members in this room seen since T", so room+seenAt is
  // the only access path that matters.
  @@index([room, seenAt])
}

// A community message a member bookmarked. Shown on their public profile, so
// only visible messages are ever listed (the read filters on the message's own
// status, so a message hidden later drops off every profile at once).
model ChatBookmark {
  id        String      @id @default(cuid())
  createdAt DateTime    @default(now())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId]) // one bookmark per member per message
  @@index([userId, createdAt]) // a profile's bookmarks, newest first
}

// RETIRED (v1 of /creators, link submission). Nothing reads or writes it any
// more - the board is built from XTweet now. It stays in the schema only
// because the production build runs `prisma db push` WITHOUT
// --accept-data-loss, so dropping a table that has rows would fail the deploy.
// Drop it deliberately (and empty) in a later change if wanted.
model CreatorPost {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  tweetId        String   @unique
  url            String
  authorHandle   String
  authorName     String
  authorAvatar   String?
  verified       Boolean  @default(false)
  text           String
  tweetCreatedAt DateTime
  likes          Int      @default(0)
  replies        Int      @default(0)
  status         String   @default("visible")
  fetchedAt      DateTime @default(now())
  submittedById  String?

  @@index([status, fetchedAt])
  @@index([authorHandle])
}

// An X account seen on the /creators Variational board (by indexing or by a
// visitor scanning its handle). `handleLower` is the key: X handles are
// case-insensitive.
model XAccount {
  id          String    @id @default(cuid())
  handleLower String    @unique
  handle      String
  xId         String?
  name        String
  avatar      String?
  followers   Int       @default(0)
  verified    Boolean   @default(false)
  bio         String    @default("")
  hidden      Boolean   @default(false) // admin: removed from the board
  scannedAt   DateTime? // last full handle scan
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())
}

// One Variational post on X, with the counts as last read from twitterapi.io.
model XTweet {
  id             String   @id @default(cuid())
  tweetId        String   @unique
  authorLower    String
  url            String
  text           String
  tweetCreatedAt DateTime
  views          Int      @default(0)
  likes          Int      @default(0)
  replies        Int      @default(0)
  reposts        Int      @default(0)
  quotes         Int      @default(0)
  bookmarks      Int      @default(0)
  isReply        Boolean  @default(false)
  // Venues the post is about (see VENUES in twitterapi.ts). Added after the
  // first release; the default covers rows written when the board tracked
  // Variational only. A plain added column with a default, so `db push`
  // applies it without --accept-data-loss.
  venues         String[] @default(["variational"])
  fetchedAt      DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([authorLower, tweetCreatedAt])
  @@index([tweetCreatedAt])
  @@index([fetchedAt])
}

// Bookkeeping for the indexer: one row per job ("index"), plus the daily
// twitterapi.io spend counter that caps cost.
model CreatorSync {
  key       String   @id
  runAt     DateTime @default(now())
  cursor    String?
  day       String   @default("")
  spent     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// YouTube discovery results per /creators topic, kept in the DB so a deploy,
// a cache-key change or a YouTube quota error never forces a re-search (100
// quota units a call) or leaves the tab empty. `videos` holds every search
// hit with stats and channel info, unfiltered: relevance is applied at read
// time, so a tightened rule needs no new quota.
model YtDiscovery {
  topic     String   @id
  videos    Json
  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================ XYZ Crypto Academy
// Content is DB-driven (seeded once from src/modules/academy/content/*.json,
// then edited from /dashboard/academy). Every score and every XP point is
// computed on the server; the browser only ever submits a choice.

model AcademyCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  tagline   String   @default("")
  icon      String   @default("BookOpen")
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules   AcademyModule[]
  questions AcademyQuestion[]

  @@index([published, order])
}

model AcademyModule {
  id         String   @id @default(cuid())
  categoryId String
  slug       String
  level      String // beginner | intermediate | advanced | expert
  title      String
  summary    String   @default("")
  minutes    Int      @default(5)
  objectives Json // string[]
  sections   Json // {heading, body}[]
  concepts   Json // {term, definition}[]
  example    Json? // {title, body}
  order      Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category  AcademyCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  questions AcademyQuestion[]
  progress  AcademyProgress[]

  @@unique([categoryId, slug])
  @@index([categoryId, order])
}

model AcademyQuestion {
  id          String   @id @default(cuid())
  categoryId  String
  moduleId    String?
  difficulty  String // easy | medium | hard | expert
  prompt      String
  options     Json // string[4]
  answer      Int // index into options - NEVER sent to a browser before that question is answered
  explanation String   @default("")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category AcademyCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  module   AcademyModule?  @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  @@index([categoryId, difficulty, active])
  @@index([moduleId])
  @@index([active, difficulty])
}

/// Per-member Academy totals. Denormalized from AcademyXp / AcademyAttempt in
/// the same transaction that writes them.
model AcademyProfile {
  userId        String   @id
  xp            Int      @default(0)
  quizzes       Int      @default(0)
  answered      Int      @default(0)
  correct       Int      @default(0)
  streak        Int      @default(0)
  bestStreak    Int      @default(0)
  lastActiveDay String? // UTC YYYY-MM-DD of the last finished quiz
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([xp])
}

/// The XP ledger. `key` is the idempotency key ("quiz:<attemptId>",
/// "streak:<user>:<day>", ...): a reward can only ever be written once.
/// Period leaderboards are SUMs over this table by createdAt.
model AcademyXp {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String // quiz | module | streak | achievement | live | daily | weekly | admin
  key       String   @unique
  label     String   @default("")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt, userId])
  @@index([userId, createdAt])
}

model AcademyAttempt {
  id          String    @id @default(cuid())
  userId      String
  mode        String // quick | topic | daily | weekly | advanced | module | challenge | mistakes | speed
  categoryId  String?
  moduleId    String?
  difficulty  String    @default("mixed")
  questionIds String[]
  // Per question, the order the options were shown in: shown[i] = original index.
  shuffles    Json
  current     Int       @default(0)
  // When the CURRENT question was served. The server times every answer from this.
  servedAt    DateTime  @default(now())
  revealed    Boolean   @default(false) // current question answered, waiting for "next"
  status      String    @default("active") // active | done
  periodKey   String? // daily/weekly challenge: one attempt per member per period
  challengeOf String? // attempt id this one replays ("Challenge friends")
  // Question indexes where the 50:50 lifeline was used (that answer scores half).
  fiftyUsed   Int[]     @default([])
  score       Int       @default(0)
  // Score from answers that still earn XP (not repeats inside the cooldown).
  xpScore     Int       @default(0)
  correct     Int       @default(0)
  bestRun     Int       @default(0)
  run         Int       @default(0)
  timeMs      Int       @default(0)
  xp          Int       @default(0)
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers AcademyAnswer[]

  @@unique([userId, mode, periodKey])
  @@index([userId, startedAt])
  @@index([status, finishedAt])
}

model AcademyAnswer {
  id         String   @id @default(cuid())
  attemptId  String
  userId     String
  index      Int
  questionId String
  choice     Int // ORIGINAL option index, -1 = timed out
  correct    Boolean
  ms         Int
  points     Int
  // false = answered correctly for XP within the repeat cooldown: scores, earns no XP.
  fresh      Boolean  @default(true)
  assisted   Boolean  @default(false) // 50:50 lifeline used on this question
  createdAt  DateTime @default(now())

  attempt AcademyAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, index])
  @@index([userId, questionId, createdAt])
  @@index([createdAt])
}

model AcademyProgress {
  userId      String
  moduleId    String
  score       Int      @default(0) // best knowledge-check accuracy, 0-100
  completedAt DateTime @default(now())

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  module AcademyModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([userId, moduleId])
}

model AcademyAchievement {
  userId   String
  code     String
  earnedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, code])
  @@index([earnedAt])
}

/// Admin-editable settings (XP values, levels, award rules, achievements).
/// Missing keys fall back to the defaults in src/modules/academy/lib/config.ts.
model AcademyConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// A live multiplayer quiz. Timing is a pure function of startedAt, pausedMs and
/// the per-question durations (see live-clock.ts), so every client and the
/// server agree on which question is open without a ticking process anywhere.
model AcademyLive {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  scheduledAt DateTime
  status      String    @default("scheduled") // scheduled | live | ended | cancelled
  questionIds String[]
  questionSec Int       @default(20)
  revealSec   Int       @default(7)
  startedAt   DateTime?
  pausedAt    DateTime?
  pausedMs    Int       @default(0)
  endedAt     DateTime?
  finalizedAt DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  participants AcademyLiveParticipant[]
  answers      AcademyLiveAnswer[]

  @@index([status, scheduledAt])
}

model AcademyLiveParticipant {
  liveId   String
  userId   String
  joinedAt DateTime @default(now())
  score    Int      @default(0)
  correct  Int      @default(0)
  totalMs  Int      @default(0)
  rank     Int?

  live AcademyLive @relation(fields: [liveId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([liveId, userId])
  @@index([liveId, score])
}

model AcademyLiveAnswer {
  liveId    String
  userId    String
  index     Int
  choice    Int
  correct   Boolean
  ms        Int
  points    Int
  createdAt DateTime @default(now())

  live AcademyLive @relation(fields: [liveId], references: [id], onDelete: Cascade)

  @@id([liveId, userId, index])
}

model AcademyCertificate {
  id          String   @id @default(cuid())
  code        String   @unique // public id on the certificate, e.g. XYZ-7F3K-92QD
  userId      String
  kind        String // daily | weekly | monthly | live | event | milestone
  periodKey   String // "2026-11-19", "2026-W47", "2026-11", "live:<id>", "event:<slug>"
  title       String
  displayName String
  rank        Int
  score       Int
  status      String   @default("issued") // pending | issued | revoked
  issuedAt    DateTime @default(now())
  issuedById  String?
  template    String   @default("gold")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([kind, periodKey, userId])
  @@index([kind, periodKey, rank])
  @@index([userId, issuedAt])
  @@index([status, issuedAt])
}

/// Marks a leaderboard period as finalized (winners computed, certificates
/// created). Its primary key makes finalization run exactly once.
model AcademyPeriodClose {
  key      String   @id // "daily:2026-11-19" | "weekly:2026-W47" | "monthly:2026-11"
  closedAt DateTime @default(now())
  winners  Json
}

/// Last-hour rank snapshot per board, for the rank-movement arrows.
model AcademyBoardSnap {
  key       String   @id
  ranks     Json // { userId: rank }
  prevRanks Json
  takenAt   DateTime @default(now())
}
