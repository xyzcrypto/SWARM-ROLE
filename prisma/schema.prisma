// XYZ Crypto database schema — Supabase Postgres.
//
// DATABASE_URL  = Supabase POOLED connection (Transaction mode, port 6543).
//                 MUST include `?pgbouncer=true` — this disables prepared
//                 statements, which the pgbouncer pooler does not support.
//                 Without it, serverless requests fail with:
//                 "42P05 prepared statement \"sN\" already exists".
//                 Recommended: `?pgbouncer=true&connection_limit=1`.
// DIRECT_URL    = Supabase DIRECT connection (port 5432) — used for migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("USER") // "USER" | "ADMIN"
  membership    String    @default("Free") // "Free" | "Premium"
  provider      String    @default("credentials") // "credentials" | "google"
  createdAt     DateTime  @default(now())
  lastLoginAt   DateTime?

  // Brute-force defence (works without Upstash): lock the account for a short
  // window after repeated failed password attempts; reset on success.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  // Granular staff capabilities (catalog in src/lib/permissions.ts). Super Admins
  // (ADMIN_EMAILS) implicitly hold all permissions regardless of this column.
  permissions String[] @default([])

  // News hub: categories the member follows for their personalized "For You" feed.
  newsInterests String[] @default([])

  // Per-user daily AI request override (null = use the plan default). Set by the
  // admin AI-usage editor; capped/enforced by src/lib/ai/limits.ts.
  aiDailyLimit Int?

  // --- Public profile fields (see /u/[username] + /settings) ---
  username    String? @unique // handle for the public profile URL, 3–20 [a-z0-9_]
  bio         String? // short about, <= 280 chars
  location    String? // free text, <= 80 chars
  website     String? // full URL
  twitter     String? // handle only (no @ / URL)
  github      String? // handle only
  telegram    String? // handle only
  bannerImage String? // optional profile cover image URL

  posts             Post[]
  accounts          Account[]
  sessions          Session[]
  comments          Comment[]
  likes             PostLike[]
  chatMessages      ChatMessage[]
  chatReactions     ChatReaction[]
  chatPollVotes     ChatPollVote[]
  notifications     Notification[]
  adminAudits       AdminAudit[]        @relation("AdminAuditActor")
  pushSubscriptions PushSubscription[]
  aiUsage           AiUsage[]
  savedStories      SavedStory[]
  newsLikes         NewsLike[]
  newsComments      NewsComment[]

  @@index([createdAt]) // dashboard "new in last 7 days" aggregate
  @@index([username]) // public profile lookup
  @@index([membership, createdAt]) // dashboard premium-member list (Phase 1)
}

// In-app notifications (bell dropdown). Created server-side when a new post is
// published or someone comments on your post; delivery is in-app (polled by the
// navbar). Best-effort: creation never blocks the triggering action.
model Notification {
  id        String   @id @default(cuid())
  type      String // "new_post" | "new_comment" | "new_message" | "system"
  title     String
  body      String? // optional preview line
  href      String? // where clicking the notification navigates
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId, read, createdAt]) // unread badge + recent list per user
  @@index([userId, createdAt]) // recent list ORDER BY createdAt (Phase 1)
}

// Community chat — single public room, plain-text messages. `status` enables
// moderation (visible | hidden) without hard deletes; delivery is realtime
// (Supabase broadcast) with the DB as history/source of truth.
model ChatMessage {
  id        String    @id @default(cuid())
  body      String // plain text, <= 500 chars (zod-enforced)
  kind      String    @default("text") // "text" | "poll"
  status    String    @default("visible") // "visible" | "hidden"
  createdAt DateTime  @default(now())
  editedAt  DateTime? // set when the author edits (15-min window)
  pinnedAt  DateTime? // set when staff pins (Telegram-style; latest pinned shows in the banner)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Reply / quote (self-relation). Detaches (null) if the parent is removed.
  replyToId String?
  replyTo   ChatMessage?  @relation("ChatReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ChatMessage[] @relation("ChatReply")

  reactions ChatReaction[]
  poll      ChatPoll?

  @@index([status, createdAt]) // history queries: visible, newest-first
}

// Telegram-style poll attached to a chat message (kind = "poll"; the message
// body carries the question for graceful fallback rendering).
model ChatPoll {
  id        String   @id @default(cuid())
  question  String // <= 200 chars (zod-enforced)
  createdAt DateTime @default(now())

  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String      @unique

  options ChatPollOption[]
  votes   ChatPollVote[]
}

model ChatPollOption {
  id    String @id @default(cuid())
  text  String // <= 80 chars (zod-enforced)
  order Int    @default(0)

  poll   ChatPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId String

  votes ChatPollVote[]

  @@index([pollId, order])
}

// One vote per user per poll; changing your vote updates the row, voting the
// same option again retracts it (Telegram behaviour).
model ChatPollVote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  poll     ChatPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId   String
  option   ChatPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionId String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String

  @@unique([pollId, userId])
  @@index([optionId])
}

// Emoji reactions on chat messages — one row per (message, user, emoji).
model ChatReaction {
  id        String   @id @default(cuid())
  emoji     String // from a fixed allowlist (see src/lib/chat.ts)
  createdAt DateTime @default(now())

  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model Post {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String
  content   String   // markdown / long text
  cover     String?  // image URL
  category  String   @default("Research") // Research | Article | Post
  tags      String   @default("") // comma separated
  published Boolean  @default(true)
  premium   Boolean  @default(false) // Premium Content — body gated to Premium users
  summary   String?  // AI-generated TL;DR (XYZ AI) — shown atop the article
  views     Int      @default(0) // total opens (incremented on the article page)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId String?
  comments Comment[]
  likes    PostLike[]

  // Supports the research list query: where published+category order by createdAt
  @@index([published, category, createdAt])
}

// Post likes — one per user per post; toggled via /api/posts/[id]/like.
model PostLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([postId, userId])
}

// Saved news stories — one per user per external story URL. Stores enough of the
// story to render the "Saved" tab without re-fetching the live feed (which ages
// out), so saves persist across devices + time. Toggled via /api/news/saved.
model SavedStory {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  url         String
  title       String
  summary     String?
  source      String?
  image       String?
  category    String?
  publishedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([userId, url])
  @@index([userId, createdAt])
}

// A like on an external news story, keyed by its URL. One per user per story.
model NewsLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  url       String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([userId, url])
  @@index([url])
}

// A comment on an external news story, keyed by its URL. `status` allows
// hiding (moderation) without deleting.
model NewsComment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  url       String
  body      String
  status    String   @default("visible") // "visible" | "hidden"
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@index([url, createdAt])
}

// Post comments — auto-published, logged-in users only; `status` enables
// moderation (visible | hidden) without deleting.
model Comment {
  id        String   @id @default(cuid())
  body      String
  status    String   @default("visible") // "visible" | "hidden"
  createdAt DateTime @default(now())

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([postId, createdAt])
}

// Lightweight self-hosted page-view analytics. One row per tracked view
// (deduped per session client-side); admin aggregates totals + today.
model PageView {
  id        String   @id @default(cuid())
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt]) // analytics filters/sorts (Phase 1)
}

// Email waitlist / newsletter capture (low-friction, no account needed)
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("website") // where the signup came from
  createdAt DateTime @default(now())
}

// --- NextAuth adapter models ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// One-time codes for email OTP (signup verification, 2FA login, password reset).
// Only the bcrypt hash of the code is stored; codes are single-use and expire.
model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  purpose   String // "signup" | "login" | "reset"
  codeHash  String
  payload   String? // JSON (e.g. pending signup: name + passwordHash)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, purpose])
}

// "What's New" feed — admin-managed changelog surfaced on the homepage. Entries
// are created automatically when research is published (postId set) and manually
// by staff with the `whatsnew:manage` permission. Filterable/searchable by tag.
model WhatsNewEntry {
  id        String   @id @default(cuid())
  title     String
  body      String
  tag       String   @default("New") // New | Improved | Fixed | Announcement | Security | Roadmap
  date      DateTime @default(now())
  postId    String? // linked research post for auto-generated entries
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([published, date]) // public feed ordering
  @@index([tag, date]) // tab filtering
}

// Web Push subscriptions (news alerts). One row per browser endpoint; tied to a
// user so we can target + clean up. Dead endpoints are pruned on send (410/404).
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  @@index([userId])
}

// Dedupe log so the same news story is never pushed twice.
model PushedStory {
  url       String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Audit trail for sensitive admin actions (role/permission grants). Append-only;
// keeps a who/what/when record so access changes are reviewable.
model AdminAudit {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  action    String // e.g. "access.update"
  targetId  String? // affected user id
  detail    String? // short JSON summary of the change
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Per-call AI usage log — one row per gateway call. Metadata only (NEVER the
// prompt/response text): powers per-user daily limits, the admin AI dashboard
// and cost visibility. userId is nullable + SET NULL so analytics survive
// account deletion. Cost is integer micro-dollars (1e-6 USD) to avoid float drift.
model AiUsage {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider         String // "groq" | "gemini" | "none"
  model            String
  task             String // "assistant" | "summary" | "moderation" | "why" | "digest"
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  latencyMs        Int      @default(0)
  status           String // "ok" | "fallback" | "error"
  errorKind        String? // "rate_limit" | "auth" | "timeout" | "safety" | "server" | "unknown"
  estCostUsdMicros Int      @default(0)
  cached           Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt]) // per-user daily count (limits) + top users
  @@index([provider, createdAt]) // provider split / health
}
