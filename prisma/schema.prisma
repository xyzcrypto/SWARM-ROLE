// XYZ Crypto database schema — Supabase Postgres.
//
// DATABASE_URL  = Supabase POOLED connection (Transaction mode, port 6543).
//                 MUST include `?pgbouncer=true` — this disables prepared
//                 statements, which the pgbouncer pooler does not support.
//                 Without it, serverless requests fail with:
//                 "42P05 prepared statement \"sN\" already exists".
//                 Recommended: `?pgbouncer=true&connection_limit=1`.
// DIRECT_URL    = Supabase DIRECT connection (port 5432) — used for migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("USER") // "USER" | "ADMIN"
  membership    String    @default("Free") // "Free" | "Premium"
  provider      String    @default("credentials") // "credentials" | "google"
  createdAt     DateTime  @default(now())
  lastLoginAt   DateTime?

  // Brute-force defence (works without Upstash): lock the account for a short
  // window after repeated failed password attempts; reset on success.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  // Granular staff capabilities (catalog in src/lib/permissions.ts). Super Admins
  // (ADMIN_EMAILS) implicitly hold all permissions regardless of this column.
  permissions String[] @default([])

  // News hub: categories the member follows for their personalized "For You" feed.
  newsInterests String[] @default([])

  // Per-user daily AI request override (null = use the plan default). Set by the
  // admin AI-usage editor; capped/enforced by src/lib/ai/limits.ts.
  aiDailyLimit Int?

  // --- Public profile fields (see /u/[username] + /settings) ---
  username    String? @unique // handle for the public profile URL, 3–20 [a-z0-9_]
  bio         String? // short about, <= 280 chars
  location    String? // free text, <= 80 chars
  website     String? // full URL
  twitter     String? // handle only (no @ / URL)
  github      String? // handle only
  telegram    String? // handle only
  discord     String? // invite code / handle (migration 20)
  youtube     String? // channel handle, no @ (migration 20)
  linkedin    String? // profile/company slug (migration 20)
  instagram   String? // handle only (migration 20)
  bannerImage String? // optional profile cover image URL

  posts             Post[]
  accounts          Account[]
  sessions          Session[]
  comments          Comment[]
  likes             PostLike[]
  chatMessages      ChatMessage[]
  chatReactions     ChatReaction[]
  chatPollVotes     ChatPollVote[]
  notifications     Notification[]
  adminAudits       AdminAudit[]        @relation("AdminAuditActor")
  pushSubscriptions PushSubscription[]
  aiUsage           AiUsage[]
  savedStories      SavedStory[]
  newsLikes         NewsLike[]
  newsComments      NewsComment[]
  conversationsA    Conversation[]     @relation("ConvUserA")
  conversationsB    Conversation[]     @relation("ConvUserB")
  directMessages    DirectMessage[]    @relation("DMSender")
  followers         Follow[]           @relation("Following") // rows where this user is followed
  following         Follow[]           @relation("Follower")  // rows where this user follows someone
  trades            Trade[]
  riskProfile       RiskProfile?
  challenges        Challenge[]
  challengeEntries  ChallengeParticipant[]

  @@index([createdAt]) // dashboard "new in last 7 days" aggregate
  @@index([username]) // public profile lookup
  @@index([membership, createdAt]) // dashboard premium-member list (Phase 1)
}

// In-app notifications (bell dropdown). Created server-side when a new post is
// published or someone comments on your post; delivery is in-app (polled by the
// navbar). Best-effort: creation never blocks the triggering action.
model Notification {
  id        String   @id @default(cuid())
  type      String // "new_post" | "new_comment" | "new_message" | "system"
  title     String
  body      String? // optional preview line
  href      String? // where clicking the notification navigates
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId, read, createdAt]) // unread badge + recent list per user
  @@index([userId, createdAt]) // recent list ORDER BY createdAt (Phase 1)
}

// Community chat — single public room, plain-text messages. `status` enables
// moderation (visible | hidden) without hard deletes; delivery is realtime
// (Supabase broadcast) with the DB as history/source of truth.
model ChatMessage {
  id        String    @id @default(cuid())
  body      String // plain text, <= 500 chars (zod-enforced)
  kind      String    @default("text") // "text" | "poll"
  status    String    @default("visible") // "visible" | "hidden"
  createdAt DateTime  @default(now())
  editedAt  DateTime? // set when the author edits (15-min window)
  pinnedAt  DateTime? // set when staff pins (Telegram-style; latest pinned shows in the banner)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Reply / quote (self-relation). Detaches (null) if the parent is removed.
  replyToId String?
  replyTo   ChatMessage?  @relation("ChatReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ChatMessage[] @relation("ChatReply")

  reactions ChatReaction[]
  poll      ChatPoll?

  @@index([status, createdAt]) // history queries: visible, newest-first
}

// Telegram-style poll attached to a chat message (kind = "poll"; the message
// body carries the question for graceful fallback rendering).
model ChatPoll {
  id        String   @id @default(cuid())
  question  String // <= 200 chars (zod-enforced)
  createdAt DateTime @default(now())

  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String      @unique

  options ChatPollOption[]
  votes   ChatPollVote[]
}

model ChatPollOption {
  id    String @id @default(cuid())
  text  String // <= 80 chars (zod-enforced)
  order Int    @default(0)

  poll   ChatPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId String

  votes ChatPollVote[]

  @@index([pollId, order])
}

// One vote per user per poll; changing your vote updates the row, voting the
// same option again retracts it (Telegram behaviour).
model ChatPollVote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  poll     ChatPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId   String
  option   ChatPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionId String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String

  @@unique([pollId, userId])
  @@index([optionId])
}

// Emoji reactions on chat messages — one row per (message, user, emoji).
model ChatReaction {
  id        String   @id @default(cuid())
  emoji     String // from a fixed allowlist (see src/lib/chat.ts)
  createdAt DateTime @default(now())

  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model Post {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String
  content   String   // markdown / long text
  cover     String?  // image URL
  category  String   @default("Research") // Research | Article | Post
  tags      String   @default("") // comma separated
  published Boolean  @default(true)
  premium   Boolean  @default(false) // Premium Content — body gated to Premium users
  summary   String?  // AI-generated TL;DR (XYZ AI) — shown atop the article
  views     Int      @default(0) // total opens (incremented on the article page)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId String?
  comments Comment[]
  likes    PostLike[]

  // Supports the research list query: where published+category order by createdAt
  @@index([published, category, createdAt])
}

// Post likes — one per user per post; toggled via /api/posts/[id]/like.
model PostLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([postId, userId])
}

// Saved news stories — one per user per external story URL. Stores enough of the
// story to render the "Saved" tab without re-fetching the live feed (which ages
// out), so saves persist across devices + time. Toggled via /api/news/saved.
model SavedStory {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  url         String
  title       String
  summary     String?
  source      String?
  image       String?
  category    String?
  publishedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([userId, url])
  @@index([userId, createdAt])
}

// A like on an external news story, keyed by its URL. One per user per story.
model NewsLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  url       String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([userId, url])
  @@index([url])
}

// A comment on an external news story, keyed by its URL. `status` allows
// hiding (moderation) without deleting.
model NewsComment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  url       String
  body      String
  status    String   @default("visible") // "visible" | "hidden"
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@index([url, createdAt])
}

// Direct messages (Telegram-style 1-on-1). A Conversation is the canonical pair
// of two users, stored with userAId < userBId so the pair is unique regardless
// of who opens it. Denormalized last-message fields let the inbox render in a
// single query (no join to messages) and drive the unread badge.
model Conversation {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  lastMessageAt DateTime  @default(now())
  lastBody      String? // preview snippet of the most recent message
  lastSenderId  String? // who sent the last message (for the unread calc)
  userAId       String
  userBId       String
  readAAt       DateTime? // when user A last opened the thread
  readBAt       DateTime? // when user B last opened the thread
  userA         User      @relation("ConvUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB         User      @relation("ConvUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages      DirectMessage[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
}

model DirectMessage {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  body           String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("DMSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// Post comments — auto-published, logged-in users only; `status` enables
// moderation (visible | hidden) without deleting.
model Comment {
  id        String   @id @default(cuid())
  body      String
  status    String   @default("visible") // "visible" | "hidden"
  createdAt DateTime @default(now())

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([postId, createdAt])
}

// Lightweight self-hosted page-view analytics. One row per tracked view
// (deduped per session client-side); admin aggregates totals + today.
model PageView {
  id        String   @id @default(cuid())
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt]) // analytics filters/sorts (Phase 1)
}

// Email waitlist / newsletter capture (low-friction, no account needed)
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("website") // where the signup came from
  createdAt DateTime @default(now())
}

// --- NextAuth adapter models ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// One-time codes for email OTP (signup verification, 2FA login, password reset).
// Only the bcrypt hash of the code is stored; codes are single-use and expire.
model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  purpose   String // "signup" | "login" | "reset"
  codeHash  String
  payload   String? // JSON (e.g. pending signup: name + passwordHash)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, purpose])
}

// "What's New" feed — admin-managed changelog surfaced on the homepage. Entries
// are created automatically when research is published (postId set) and manually
// by staff with the `whatsnew:manage` permission. Filterable/searchable by tag.
model WhatsNewEntry {
  id        String   @id @default(cuid())
  title     String
  body      String
  tag       String   @default("New") // New | Improved | Fixed | Announcement | Security | Roadmap
  date      DateTime @default(now())
  postId    String? // linked research post for auto-generated entries
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([published, date]) // public feed ordering
  @@index([tag, date]) // tab filtering
}

// Web Push subscriptions (news alerts). One row per browser endpoint; tied to a
// user so we can target + clean up. Dead endpoints are pruned on send (410/404).
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  // Notification preference (per-device). "high" = all high-impact (default,
  // preserves prior behavior), "foryou" = only the user's newsInterests,
  // "categories" = only notifyCategories, "off" = none.
  notifyMode       String   @default("high")
  notifyCategories String[] @default([])

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  @@index([userId])
}

// Dedupe log so the same news story is never pushed twice.
model PushedStory {
  url       String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Audit trail for sensitive admin actions (role/permission grants). Append-only;
// keeps a who/what/when record so access changes are reviewable.
model AdminAudit {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  action    String // e.g. "access.update"
  targetId  String? // affected user id
  detail    String? // short JSON summary of the change
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Per-call AI usage log — one row per gateway call. Metadata only (NEVER the
// prompt/response text): powers per-user daily limits, the admin AI dashboard
// and cost visibility. userId is nullable + SET NULL so analytics survive
// account deletion. Cost is integer micro-dollars (1e-6 USD) to avoid float drift.
model AiUsage {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider         String // "groq" | "gemini" | "none"
  model            String
  task             String // "assistant" | "summary" | "moderation" | "why" | "digest"
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  latencyMs        Int      @default(0)
  status           String // "ok" | "fallback" | "error"
  errorKind        String? // "rate_limit" | "auth" | "timeout" | "safety" | "server" | "unknown"
  estCostUsdMicros Int      @default(0)
  cached           Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt]) // per-user daily count (limits) + top users
  @@index([provider, createdAt]) // provider split / health
}

// XYZ Sentinel — one row per scheduled security/health check. Used for history
// (a future dashboard) and to dedupe alerts (only notify when flags change vs
// the previous run). See src/app/api/watchdog/route.ts. (migration 21)
model WatchdogRun {
  id       String   @id @default(cuid())
  ranAt    DateTime @default(now())
  severity String // "ok" | "info" | "warn" | "critical"
  flags    String[] // human-readable hard-rule flags that tripped
  summary  String? // AI-written risk summary (advisory)
  metrics  Json? // the raw Signals snapshot
  alerted  Boolean  @default(false) // did we notify the owner this run?

  @@index([ranAt])
}

// Twitter-style follow graph. One row per (follower -> following) edge.
model Follow {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  follower    User   @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  String
  following   User   @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String

  @@unique([followerId, followingId]) // can't follow the same person twice
  @@index([followingId]) // follower list + count for a profile
  @@index([followerId]) // following list + count for a profile
}

// Trading Journal (Trading OS Phase 1). One row per logged position; the
// actual entries/exits live in TradeFill (supports multiple entries and
// partial exits) - P&L, average entry price, and open/closed size are all
// DERIVED from a trade's fills (src/lib/journal.ts), never stored redundantly.
model Trade {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  symbol String // free text, e.g. "BTC", "ETH" - uppercased client-side
  side   String // "long" | "short"
  type   String @default("perp") // "spot" | "futures" | "perp" | "custom"
  status String @default("open") // "open" | "closed" | "partial" | "canceled" | "invalid"

  platformId String? // optional link to src/lib/dex-registry.ts DexPlatform.id
  leverage   Float?  @default(1)

  stopLoss   Float?
  takeProfit Float?

  setup          String? // strategy/setup tag
  marketCondition String?
  session        String? // e.g. "Asia" | "London" | "New York"
  timeframe      String?
  assetCategory  String?
  tags           String[] @default([])
  emotions       String[] @default([])
  mistakes       String[] @default([])
  lessons        String?
  notes          String?
  screenshots    String[] @default([])
  customFields   Json?

  visibility String @default("private") // "private" | "public" | "anonymous"

  fills     TradeFill[]
  revisions TradeRevision[]

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Optional link to a Trading OS challenge - progress is derived from linked
  // trades (src/lib/challenge.ts), not duplicated. SetNull so deleting a
  // challenge never deletes the trade itself.
  challenge   Challenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  challengeId String?

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([challengeId])
}

// One entry or exit execution on a Trade. Multiple entry fills = averaging in;
// multiple exit fills = scaling out / partial exits.
model TradeFill {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  kind       String // "entry" | "exit"
  price      Float
  size       Float // base-asset units
  fee        Float    @default(0)
  executedAt DateTime @default(now())

  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  tradeId String

  @@index([tradeId, executedAt])
}

// Append-only edit history. One row per PATCH, capturing what changed - a
// lightweight "trade edit history" without a full versioning system.
model TradeRevision {
  id        String   @id @default(cuid())
  changedAt DateTime @default(now())
  diff      Json // { field: { from, to } } for each changed field
  editedBy  String // userId of the editor (always the owner today)

  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  tradeId String

  @@index([tradeId, changedAt])
}

// Trading OS Phase 3 - one optional per-user risk configuration. Breach
// detection/rule-adherence scoring (src/lib/risk.ts) is all computed
// client-side from this + the trade list; this row only persists the limits
// the member has chosen to set for themselves.
model RiskProfile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountEquity          Float?
  maxRiskPerTradePct     Float?
  maxDailyLossPct        Float?
  maxWeeklyDrawdownPct   Float?
  maxOpenRiskPct         Float?
  maxLeverage            Float?
  maxTradesPerDay        Int?
  revengeCooldownMinutes Int?     @default(30)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique
}

// Trading OS Phase 4 - a custom-duration trading challenge. Duration is fully
// flexible (30/90/120-day presets are just UI shortcuts, not hardcoded modes).
// Progress is DERIVED from the trades linked to it (Trade.challengeId) plus
// startingCapital - see src/lib/challenge.ts. Not just solo: a "community"
// challenge is one creator + many ChallengeParticipant rows, ranked on a
// leaderboard by each participant's own linked trades.
model Challenge {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  description String?

  startDate       DateTime
  endDate         DateTime
  startingCapital Float
  targetCapital   Float?

  maxRiskPerTradePct   Float?
  maxDailyLossPct      Float?
  maxWeeklyDrawdownPct Float?
  customRules          String[] @default([])

  visibility String @default("private") // "private" | "public" | "community"
  status     String @default("active") // "active" | "completed" | "failed" | "abandoned"

  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String

  participants ChallengeParticipant[]
  milestones   ChallengeMilestone[]
  trades       Trade[]

  @@index([creatorId, createdAt])
  @@index([visibility, status])
}

// One row per participant in a challenge (the creator is a participant too,
// role="owner" - so leaderboard queries are just "all participants").
model ChallengeParticipant {
  id       String   @id @default(cuid())
  joinedAt DateTime @default(now())
  role     String   @default("participant") // "owner" | "participant"

  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  challengeId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  @@unique([challengeId, userId])
  @@index([userId])
}

// A review checkpoint within a challenge - a lightweight, manually-toggled
// milestone (not auto-computed) so it can represent anything ("halfway
// review", "hit first profit target", a habit check-in).
model ChallengeMilestone {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  label      String
  targetDate DateTime?
  achieved   Boolean   @default(false)
  achievedAt DateTime?

  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  challengeId String

  @@index([challengeId])
}
