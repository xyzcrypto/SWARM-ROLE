# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files - ignore EVERY .env variant, allow only the committed
# template. The previous rules (`.env` + `.env*.local`) left .env.production,
# .env.staging and - most dangerously - .env.backup tracked. Copying .env to
# .env.backup before editing it is a normal habit, and on a public repository
# it would commit the entire production secret set.
.env*
!.env.example

# secrets & key material - nothing here has ever been committed (history audit
# 2026-08-24 checked all 403 commits across all 67 refs and found no credential
# anywhere). These rules exist so it stays that way: `.env*` above only catches
# env files, and a secret does not have to arrive in one. `secrets.json`, an SSH
# key copied in to debug a deploy, or a `.npmrc` carrying an auth token were all
# committable before this block.
#
# Note what gitignore cannot do: it does not apply to a file that is ALREADY
# tracked, so it prevents the next accident rather than fixing a past one. If a
# secret is ever committed, rewriting history is not enough on its own - rotate
# the credential, because the push already happened.
secrets.json
secrets.yml
secrets.yaml
secret.json
secret.yml
secret.yaml
credentials.json
credentials.yml
credentials.yaml
serviceAccountKey.json
service-account*.json
gcloud-*.json
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ppk
# `*.pem` was already here under "misc"; it belongs with the rest of the key
# material rather than beside .DS_Store.
*.pem
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.pub.bak
.netrc
.npmrc
.pypirc
.htpasswd
.ssh/
.aws/
.gnupg/

# database (local sqlite)
/prisma/*.db
/prisma/*.db-journal
/prisma/dev.db
/prisma/migrations/dev

# typescript
*.tsbuildinfo

# vercel
.vercel
